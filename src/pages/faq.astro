---
import BaseLayout from '../layouts/BaseLayout.astro';
import { useLocale } from '../i18n';
import { getAllFaqs } from '../data/faq';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, faqPageSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SiteFaqSection from '../components/SiteFaqSection.astro';
import SectionHeader from '../components/SectionHeader.astro';

const { locale, t, lp } = useLocale(Astro.currentLocale);
const seo = resolvePageSeo('/faq/', locale);
const breadcrumbs = [
  { name: t.common.breadcrumbHome, path: '/' },
  { name: t.common.breadcrumbFaq, path: '/faq/' },
];
const faqPage = t.pages.faq;
const faqs = getAllFaqs(locale);
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: faqPage.schemaName,
      description: faqPage.schemaDescription,
      url: lp('/faq/'),
    }),
    faqPageSchema(
      faqs.map((f, i) => ({ num: String(i + 1).padStart(2, '0'), q: f.q, a: f.a.replace(/<[^>]+>/g, '') })),
      locale,
    ),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6">
        <SectionHeader
          eyebrow={faqPage.eyebrow}
          title={faqPage.title}
          desc={faqPage.description}
          titleId="faq-page-title"
          level="h1"
        />
      </div>
    </div>
  </section>

  <SiteFaqSection items={faqs} variant="full" titleId="faq-page-list" />
</BaseLayout>
