---
import type { ProductSlide } from '../data/products';
import ResponsiveImage from './ResponsiveImage.astro';
import Icon from './icons/Icon.astro';
import { Carousel, CarouselContent, CarouselItem } from '@/components/starwind/carousel';
import { useLocale } from '../i18n';

interface Props {
  images: ProductSlide[];
  id?: string;
  /** First frame is above-the-fold on product pages (LCP). */
  priority?: boolean;
}

const { images, id = 'product-screenshots', priority = true } = Astro.props;
const { t } = useLocale(Astro.currentLocale);
const slides = images.filter((slide) => slide.src);
const multiple = slides.length > 1;

function isVideo(slide: ProductSlide) {
  return Boolean(slide.videoSrc) || slide.kind === 'video';
}
---

<div class="media-slider" id={id} data-media-slider>
  <Carousel
    autoInit={false}
    opts={{
      loop: multiple,
      align: 'start',
      breakpoints: { '(max-width: 1023px)': { active: false } },
    }}
    class="media-slider__frame"
    aria-label="Product preview"
  >
    <CarouselContent>
      {
        slides.map((slide, i) => (
          <CarouselItem>
            <figure class="media-slider__slide">
              {isVideo(slide) && slide.videoSrc ? (
                <video
                  class="media-slider__media"
                  poster={slide.src}
                  controls
                  playsinline
                  preload={i === 0 ? 'metadata' : 'none'}
                  data-media-video
                  aria-label={slide.alt}
                >
                  <source src={slide.videoSrc} />
                </video>
              ) : (
                <ResponsiveImage
                  src={slide.src}
                  alt={slide.alt}
                  width={960}
                  height={540}
                  loading={priority && i === 0 ? 'eager' : 'lazy'}
                  fetchPriority={priority && i === 0 ? 'high' : undefined}
                  sizes="(min-width: 1024px) 720px, 320px"
                  class="media-slider__media"
                />
              )}
            </figure>
          </CarouselItem>
        ))
      }
    </CarouselContent>
    {
      multiple && (
        <>
          <button
            type="button"
            class="media-slider__nav media-slider__nav--prev"
            data-sw-carousel-previous
            aria-label="Previous preview"
          >
            <Icon name="chevronLeft" size={18} />
          </button>
          <button
            type="button"
            class="media-slider__nav media-slider__nav--next"
            data-sw-carousel-next
            aria-label="Next preview"
          >
            <Icon name="chevronRight" size={18} />
          </button>
        </>
      )
    }
  </Carousel>
</div>
{
  multiple && (
    <p class="media-slider__swipe-hint">
      <Icon name="chevronLeft" size={14} />
      <span>{t.products.swipeHint}</span>
      <Icon name="chevronRight" size={14} class="media-slider__swipe-nudge" />
    </p>
  )
}
