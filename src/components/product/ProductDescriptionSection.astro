---
import SectionHeader from '../SectionHeader.astro';
import { Button } from '@/components/starwind/button';
import { Prose } from '@/components/starwind/prose';

interface Block {
  type: 'h2' | 'p';
  text: string;
}

interface Props {
  overviewTitle?: string;
  overviewSubtitle?: string;
  blocks: Block[];
  showToggle: boolean;
}

import { linkifyMarkdown } from '../../utils/linkify';

const { overviewTitle, overviewSubtitle, blocks, showToggle } = Astro.props;
---

<section
  class="border-t border-border bg-background py-12 md:py-16"
  aria-labelledby="product-description-title"
>
  <div class="mx-auto max-w-6xl px-5">
    <SectionHeader
      eyebrow="Overview"
      title={overviewTitle ?? 'Product description'}
      desc={overviewSubtitle ?? 'How modules, presets, and patch-day status checks fit PMC raid workflows.'}
      titleId="product-description-title"
      wide
    />

    <div class:list={['desc-wrap product-detail__narrow mt-8', showToggle && 'collapsible']} data-desc-wrap>
      <Prose class="description-content max-w-none">
        {blocks.map((block) =>
          block.type === 'h2' ? <h2>{block.text}</h2> : <p set:html={linkifyMarkdown(block.text)} />,
        )}
      </Prose>
      {
        showToggle && (
          <div class="mt-6 flex justify-start lg:justify-center">
            <Button
              type="button"
              variant="outline"
              size="sm"
              class="rounded-full"
              data-desc-toggle
              data-more="Show more"
              data-less="Show less"
            >
              Show more
            </Button>
          </div>
        )
      }
    </div>
  </div>
</section>
