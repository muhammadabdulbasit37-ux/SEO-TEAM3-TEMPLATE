---
import '../styles/product-cheat-page.css';
import type { ProductPage } from '../data/products';
import type { BreadcrumbItem } from '../utils/schema';
import ProductScreenshotGallery from './ProductScreenshotGallery.astro';
import { getProductFaqs } from '../data/faq';
import SiteFaqSection from './SiteFaqSection.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import ProductDetailHeader from './product/ProductDetailHeader.astro';
import ProductCheckoutPanel from './product/ProductCheckoutPanel.astro';
import ProductHighlightsSection from './product/ProductHighlightsSection.astro';
import ProductFeaturesSection from './product/ProductFeaturesSection.astro';
import ProductDescriptionSection from './product/ProductDescriptionSection.astro';
import ProductExperienceSection from './product/ProductExperienceSection.astro';
import { useLocale } from '../i18n';
import { getBlogPostsBySlugs } from '../data/blog';
import { getForumPostsBySlugs } from '../data/forum/locale';
import ProductRelatedGuidesSection from './product/ProductRelatedGuidesSection.astro';
import ProductRelatedDiscussionsSection from './product/ProductRelatedDiscussionsSection.astro';

interface Props {
  product: ProductPage;
  breadcrumbs?: BreadcrumbItem[];
}

const { product, breadcrumbs } = Astro.props;
const { t, locale } = useLocale(Astro.currentLocale);
const relatedGuides = getBlogPostsBySlugs(product.relatedBlogSlugs, locale).slice(0, 6);
const relatedDiscussions = getForumPostsBySlugs(product.relatedForumSlugs, locale).slice(0, 4);
const isHwidUtility = product.kind === 'utility';
const hwidCopy = t.products.hwidPage;
/** `product.name` is the internal tier key (icon lookup); visible copy uses the localized product name. */
const productName = isHwidUtility ? product.name : t.cheats.title;
const productFaqs = getProductFaqs(locale, product.slug, product.kind);
const descriptionBlocks = [
  ...product.overview.paragraphs.map((text) => ({ type: 'p' as const, text })),
  ...(product.about ?? []),
  ...product.body,
];

const showDescToggle = descriptionBlocks.length > 2;
---

<div class="product-detail">
<section class="product-detail-hero py-8 md:py-12">
  <div class="mx-auto max-w-6xl px-5">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} class="product-detail__breadcrumbs" />}

    <div class="mt-6">
      <ProductDetailHeader product={product} />
    </div>

    <div class="product-detail-hero__grid mt-10 grid items-start gap-8">
      <div class="product-detail-hero__preview min-w-0">
        <h2 class="product-showcase-heading mb-4 font-[family-name:var(--font-heading)] text-2xl font-bold tracking-tight text-foreground md:text-3xl">
          {isHwidUtility && hwidCopy ? hwidCopy.showcaseHeading : t.products.showcaseHeading}
        </h2>
        <ProductScreenshotGallery images={product.images} id={`gallery-${product.slug}`} />
      </div>
      <ProductCheckoutPanel product={product} />
    </div>
  </div>
</section>

<ProductHighlightsSection product={product} productName={productName} header={isHwidUtility ? hwidCopy?.highlights : undefined} moreNote={isHwidUtility ? hwidCopy?.highlightsMore : undefined} />

<ProductDescriptionSection
  overviewTitle={product.overview.title}
  overviewSubtitle={isHwidUtility ? hwidCopy?.overviewSubtitle : undefined}
  blocks={descriptionBlocks}
  showToggle={showDescToggle}
/>

<ProductFeaturesSection
  features={product.fullFeatures}
  productName={productName}
  section={isHwidUtility ? hwidCopy?.featuresSection : undefined}
/>

<ProductExperienceSection
  images={product.images}
  acquisition={product.acquisition}
  productName={productName}
  experience={isHwidUtility ? hwidCopy?.experience : undefined}
/>

<SiteFaqSection
  id="faq"
  items={productFaqs}
  titleId={`catalog-faq-${product.slug}`}
  class="border-t border-border bg-background"
/>

<ProductRelatedGuidesSection posts={relatedGuides} productName={productName} />
<ProductRelatedDiscussionsSection threads={relatedDiscussions} />
</div>

<script>
  const initProductDetailUi = () => {
    document.querySelectorAll('[data-desc-toggle]').forEach((btn) => {
      if (btn.hasAttribute('data-desc-bound')) return;
      btn.setAttribute('data-desc-bound', '');
      btn.addEventListener('click', () => {
        const wrap = btn.closest('[data-desc-wrap]');
        if (!wrap) return;
        const open = wrap.classList.toggle('open');
        btn.textContent = open ? btn.getAttribute('data-less') ?? 'Show less' : btn.getAttribute('data-more') ?? 'Show more';
      });
    });
  };

  initProductDetailUi();
  document.addEventListener('astro:after-swap', initProductDetailUi);
</script>
